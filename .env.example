# ============================================
# BotFlow.ai — Variables de entorno
# ============================================

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Base de datos PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/botflow
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT
JWT_SECRET=tu-secreto-super-seguro-cambiar-en-produccion
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=otro-secreto-para-refresh-tokens
JWT_REFRESH_EXPIRES_IN=7d

# OAuth - Google
GOOGLE_CLIENT_ID=tu-google-client-id
GOOGLE_CLIENT_SECRET=tu-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=tu-github-client-id
GITHUB_CLIENT_SECRET=tu-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Claude API
ANTHROPIC_API_KEY=tu-api-key
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_SMART=claude-sonnet-4-20250514

# Voyage AI (Embeddings)
VOYAGE_API_KEY=tu-voyage-api-key

# Redis
REDIS_URL=redis://localhost:6379

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Mercado Pago
MP_ACCESS_TOKEN=TEST-xxx
MP_WEBHOOK_SECRET=xxx

# Frontend URL (para CORS y redirects)
FRONTEND_URL=http://localhost:3000

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_WHATSAPP_NUMBER=+14155238886
